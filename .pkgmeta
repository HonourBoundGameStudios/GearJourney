# The packager ships the addon folder under the repo name. Repo and folder are
# both GearJourney now, so this is belt-and-braces — keep it pinned explicitly
# so a future repo rename can't silently change the shipped folder name.
package-as: GearJourney

# Dev-only paths kept out of the shipped zip. None is referenced by
# GearJourney.toc, so the addon loads identically without them. Tools/ + Tests/
# alone were ~57 of the ~80 files in the 0.12.1 package (0.12.2 shipped 24).
# Dropping them also keeps the .py/.ps1 helper scripts out of the upload, which
# is what CurseForge's scanner looks at. README.md deliberately still ships —
# CurseForge surfaces it on the project page.
# NOTE: the root JourneyTests.lua / JourneyScenarios.lua ARE loaded by the toc
# (the in-client /gearjourney run-testing-scenarios suite) — the Tests entry is
# a directory name and does not match them.
ignore:
    - Tools
    - Tests
    - CLAUDE.md
    - deploy.ps1
